rules_version = '2';

// Jaunt security rules
// Paste this into Firebase console -> Firestore Database -> Rules, then Publish.
//
// Who's allowed in is stored in the document config/access:
//   owner   (string): your Google email — can read, post and delete
//   viewers (array):  invited Google emails — can read only
// Anyone else, signed in or not, gets nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == access().owner;
    }
    function isInvited() {
      return isOwner() || (signedIn() && request.auth.token.email in access().viewers);
    }

    // The invite list itself: invited people can read it, nobody can change it
    // from the app (you edit it in the Firebase console).
    match /config/access {
      allow read: if isInvited();
      allow write: if false;
    }

    match /rides/{rideId} {
      allow read: if isInvited();
      allow create, update, delete: if isOwner();
    }
  }
}
